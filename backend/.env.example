# VoltElite Backend Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true
FRONTEND_URL=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL for production/docker, SQLite supported for quick local development)
DATABASE_URL=postgresql://voltelite_user:voltelite_password@localhost:5432/voltelite_db
# For zero-config local test without Postgres:
# DATABASE_URL=sqlite:///./voltelite.db

# Security & JWT
JWT_SECRET=super_secret_volt_elite_jwt_key_change_in_production_9988776655
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret

# Phone OTP Service (Twilio / MSG91 / Mock)
OTP_PROVIDER=mock
OTP_API_KEY=mock_api_key_here
DEV_OTP_MODE=true
FIXED_DEV_OTP=123456

# Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Hardware Simulation Mode
SIMULATION_MODE=true
SIMULATION_TICK_SECONDS=2
